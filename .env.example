# ---------------------------------------------------------------------------
# LLM provider configuration (provider-agnostic via LiteLLM).
#
# Allowed providers for this project: OpenRouter and DeepSeek.
# Model strings follow LiteLLM's "<provider>/<model>" convention:
#   openrouter/deepseek/deepseek-v3.2   openrouter/deepseek/deepseek-chat
#   openrouter/anthropic/claude-sonnet-4.5
#   deepseek/deepseek-chat              deepseek/deepseek-reasoner
# ---------------------------------------------------------------------------
THEO_MODEL_STRONG=anthropic/claude-haiku-5.5
THEO_MODEL_CHEAP=~deepseek/deepseek-flash-latest

# Providers you allow (comma-separated). Model ids must start with one of these.
THEO_ALLOWED_PROVIDERS=openrouter,deepseek
# Provider used for bare OpenRouter-style ids (e.g. anthropic/claude-haiku-5.5).
THEO_DEFAULT_PROVIDER=openrouter

# Provider API keys (set the ones you use).
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Research / search MCP servers. The tool runs with ANY subset of these; a
# server is only started when its required key is present.
# ---------------------------------------------------------------------------
# Web search (discovery) - remote HTTP MCP.
EXA_API_KEY=
# Web search (extractive).
TAVILY_API_KEY=
# STEM preprints + citation graph (optional; improves Semantic Scholar quota).
SEMANTIC_SCHOLAR_API_KEY=
# Biomedical (optional; raises NCBI rate limit 3/s -> 10/s).
NCBI_API_KEY=
# NCBI requires an admin e-mail; Unpaywall needs an e-mail for open-access links.
NCBI_ADMIN_EMAIL=
UNPAYWALL_EMAIL=

# ---------------------------------------------------------------------------
# Runtime knobs.
# ---------------------------------------------------------------------------
# Cap on concurrent research/draft fan-out branches.
THEO_MAX_CONCURRENCY=4
# Directory for project artifacts (default: ./workspace).
THEO_WORKSPACE_ROOT=workspace
# Set to true to use the deterministic fake LLM backend (no network, for smoke tests).
THEO_FAKE_LLM=false
